{
  "name": "hpc-mail",
  "description": "基于 Cloudflare Workers 的多域名多用户邮箱系统",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riba2534/hpc-mail.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "concurrently -n worker,web -c yellow,cyan \"pnpm --filter @hpc-mail/worker dev\" \"pnpm --filter @hpc-mail/web dev\"",
    "build": "pnpm --filter @hpc-mail/web build && pnpm --filter @hpc-mail/worker build:assets",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
